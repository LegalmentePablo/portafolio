---
interface Props {
	id: string;
	title: string;
	intro?: string;
}

const { id, title, intro } = Astro.props;
const headingId = `${id}-title`;
---

<section class="section container" id={id} aria-labelledby={headingId} data-reveal>
	<header class="section-head">
		<h2 id={headingId}>{title}</h2>
		{intro && <p class="section-intro">{intro}</p>}
	</header>
	<div class="section-body">
		<slot />
	</div>
</section>

<style>
	.section {
		display: grid;
		grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
		gap: 1.5rem clamp(2rem, 5vw, 4rem);
		padding-top: clamp(3rem, 7vw, 5rem);
		padding-bottom: clamp(1rem, 3vw, 2rem);
	}

	.section-head {
		position: sticky;
		top: calc(var(--header-h) + 1.5rem);
		align-self: start;
		padding-top: 1.25rem;
	}

	.section-head::before,
	.section-body::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 1px;
		background: var(--line);
	}

	.section-head::before {
		height: 2px;
		background: var(--ink);
	}

	.section-body {
		position: relative;
		padding-top: 1.25rem;
	}

	h2 {
		font-size: 1.375rem;
		letter-spacing: -0.02em;
	}

	.section-intro {
		margin-top: 0.6rem;
		color: var(--ink-3);
		font-size: 0.925rem;
		line-height: 1.5;
	}

	@media (max-width: 760px) {
		.section {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.section-head {
			position: relative;
			top: auto;
		}

		.section-body {
			padding-top: 0;
		}

		.section-body::before {
			display: none;
		}
	}
</style>
