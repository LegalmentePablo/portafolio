---
import Section from '../Section.astro';
import type { ExperienceItem } from '../../data/portfolio';

interface Props {
	title: string;
	items: ExperienceItem[];
	currentLabel: string;
}

const { title, items, currentLabel } = Astro.props;
---

<Section id="experiencia" title={title}>
	<ol class="roles">
		{
			items.map((item) => (
				<li class="role">
					<div class="role-side">
						<p class="period tabular">{item.period}</p>
						{item.current && (
							<p class="current">
								<span class="dot" aria-hidden="true" />
								{currentLabel}
							</p>
						)}
					</div>
					<div class="role-main">
						<h3>
							{item.company}
							<span class="title">{item.title}</span>
						</h3>
						<p class="summary">{item.summary}</p>
						{item.highlights.length > 0 && (
							<ul class="highlights">
								{item.highlights.map((highlight) => (
									<li>{highlight}</li>
								))}
							</ul>
						)}
						<ul class="stack-line" aria-label="Stack">
							{item.stack.map((tech) => (
								<li>{tech}</li>
							))}
						</ul>
					</div>
				</li>
			))
		}
	</ol>
</Section>

<style>
	.roles {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.role {
		display: grid;
		grid-template-columns: 9.5rem minmax(0, 1fr);
		gap: 1.5rem;
		padding-bottom: 2.25rem;
	}

	.role + .role {
		padding-top: 2.25rem;
		border-top: 1px solid var(--line);
	}

	.period {
		color: var(--ink-3);
		font-size: 0.9rem;
		padding-top: 0.2rem;
	}

	.current {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		margin-top: 0.35rem;
		color: var(--accent);
		font-size: 0.85rem;
		font-weight: 600;
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: currentColor;
	}

	h3 {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		font-size: 1.3rem;
		letter-spacing: -0.02em;
	}

	.title {
		color: var(--ink-2);
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: 0;
	}

	.summary {
		max-width: 44rem;
		margin-top: 0.85rem;
		color: var(--ink-2);
	}

	.highlights {
		max-width: 44rem;
		margin-top: 1rem;
	}

	.highlights li {
		position: relative;
		padding-left: 1.25rem;
		color: var(--ink);
		font-size: 1rem;
		line-height: 1.55;
	}

	.highlights li + li {
		margin-top: 0.55rem;
	}

	.highlights li::before {
		content: '';
		position: absolute;
		left: 0.15rem;
		top: 0.72em;
		width: 0.45rem;
		height: 1px;
		background: var(--ink-3);
	}

	.stack-line {
		margin-top: 1.1rem;
		max-width: 44rem;
	}

	@media (max-width: 640px) {
		.role {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}

		.role-side {
			display: flex;
			gap: 1rem;
			align-items: baseline;
		}

		.current {
			margin-top: 0;
		}
	}
</style>
