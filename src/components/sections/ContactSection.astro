---
import Icon from '../Icon.astro';
import type { PortfolioData } from '../../data/portfolio';

interface Props {
	title: string;
	contact: PortfolioData['contact'];
	ui: PortfolioData['ui'];
	footer: string;
}

const { title, contact, ui, footer } = Astro.props;
const phoneHref = `tel:${contact.phone.replace(/\s+/g, '')}`;
const year = new Date().getFullYear();
---

<section class="contact" id="contacto" aria-labelledby="contacto-title" data-reveal>
	<div class="container">
		<h2 id="contacto-title" class="visually-hidden">{title}</h2>
		<p class="heading">{contact.heading}</p>
		<p class="message">{contact.message}</p>

		<div class="channels">
			<div class="email-row">
				<a class="email" href={`mailto:${contact.email}`}>
					<span class="visually-hidden">{contact.emailLabel}: </span>
					{contact.email}
				</a>
				<button
					type="button"
					class="copy"
					data-copy={contact.email}
					data-label={ui.copyEmail}
					data-done={ui.copied}
				>
					<Icon name="copy" size={16} class="icon-copy" />
					<Icon name="check" size={16} class="icon-check" />
					<span class="copy-text" aria-live="polite">{ui.copyEmail}</span>
				</button>
			</div>

			<ul class="links">
				<li>
					<a href={phoneHref}>
						<Icon name="phone" size={16} />
						<span class="visually-hidden">{contact.phoneLabel}: </span>
						<span class="tabular">{contact.phone}</span>
					</a>
				</li>
				{
					contact.links.map((link) => (
						<li>
							<a href={link.href} target="_blank" rel="noopener noreferrer">
								{link.label}
								<Icon name="arrow-up-right" size={14} />
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<footer class="footer">
			<p>© {year} · {footer}</p>
			<a href="#top">
				{ui.backToTop}
				<Icon name="arrow-up" size={14} />
			</a>
		</footer>
	</div>
</section>

<style>
	.contact {
		margin-top: clamp(4rem, 9vw, 7rem);
		padding-top: clamp(3.5rem, 8vw, 6rem);
		background: var(--bg-sunk);
		border-top: 1px solid var(--line);
	}

	.heading {
		font-size: clamp(2.4rem, 6vw, 4.5rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.message {
		max-width: 38rem;
		margin-top: 1.25rem;
		color: var(--ink-2);
		font-size: clamp(1.05rem, 1.5vw, 1.2rem);
		line-height: 1.55;
	}

	.channels {
		margin-top: 2.5rem;
	}

	.email-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
	}

	.email {
		font-size: clamp(1.35rem, 3.4vw, 2.1rem);
		font-weight: 650;
		letter-spacing: -0.02em;
		text-decoration: underline;
		text-decoration-color: var(--line-strong);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.18em;
		overflow-wrap: anywhere;
		transition:
			color 0.15s ease,
			text-decoration-color 0.15s ease;
	}

	.email:hover {
		color: var(--accent);
		text-decoration-color: currentColor;
	}

	.copy {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2.25rem;
		padding: 0 0.8rem;
		border: 1px solid var(--line-strong);
		border-radius: 8px;
		background: transparent;
		color: var(--ink-2);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 600;
		cursor: pointer;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.copy:hover {
		color: var(--ink);
		border-color: var(--ink);
	}

	.copy :global(.icon-check),
	.copy.is-copied :global(.icon-copy) {
		display: none;
	}

	.copy.is-copied :global(.icon-check) {
		display: block;
	}

	.copy.is-copied {
		color: var(--accent);
		border-color: var(--accent);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 2rem;
		margin-top: 1.5rem;
	}

	.links a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		color: var(--ink-2);
		font-weight: 600;
		text-decoration: none;
	}

	.links a:hover {
		color: var(--ink);
	}

	@media (max-width: 560px) {
		.links li:first-child {
			flex-basis: 100%;
		}
	}

	.footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		margin-top: clamp(3.5rem, 8vw, 6rem);
		padding: 1.5rem 0 2rem;
		border-top: 1px solid var(--line);
		color: var(--ink-3);
		font-size: 0.875rem;
	}

	.footer a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		text-decoration: none;
	}

	.footer a:hover {
		color: var(--ink);
	}
</style>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
		const text = button.querySelector<HTMLElement>('.copy-text');
		let timer: number | undefined;

		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
			} catch {
				const email = document.querySelector('.email');
				if (email) window.getSelection()?.selectAllChildren(email);
				return;
			}
			button.classList.add('is-copied');
			if (text) text.textContent = button.dataset.done ?? '';
			window.clearTimeout(timer);
			timer = window.setTimeout(() => {
				button.classList.remove('is-copied');
				if (text) text.textContent = button.dataset.label ?? '';
			}, 2000);
		});
	});
</script>
