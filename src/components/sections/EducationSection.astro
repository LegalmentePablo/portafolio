---
import Section from '../Section.astro';
import type { EducationItem } from '../../data/portfolio';

interface Props {
	title: string;
	items: EducationItem[];
}

const { title, items } = Astro.props;
---

<Section id="formacion" title={title}>
	<ul class="education">
		{
			items.map((item) => (
				<li>
					<div>
						<h3>{item.degree}</h3>
						<p>{item.institution}</p>
					</div>
					<p class="period tabular">{item.period}</p>
				</li>
			))
		}
	</ul>
</Section>

<style>
	li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.25rem 2rem;
		padding: 1rem 0;
	}

	li:first-child {
		padding-top: 0;
	}

	li + li {
		border-top: 1px solid var(--line);
	}

	h3 {
		font-size: 1.05rem;
		letter-spacing: -0.01em;
		line-height: 1.35;
	}

	p {
		color: var(--ink-2);
		font-size: 0.95rem;
	}

	.period {
		flex: none;
		color: var(--ink-3);
		font-size: 0.9rem;
	}

	@media (max-width: 560px) {
		li {
			flex-direction: column;
		}
	}
</style>
