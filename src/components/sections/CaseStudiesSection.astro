---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import type { CaseGroup, PortfolioData } from '../../data/portfolio';

interface Props {
	title: string;
	groups: CaseGroup[];
	ui: PortfolioData['ui'];
}

const { title, groups, ui } = Astro.props;
---

<Section id="casos" title={title}>
	{
		groups.map((group, groupIndex) => (
			<div class="group">
				<div class="group-head">
					<h3>{group.title}</h3>
					<p>{group.description}</p>
				</div>
				<ul class="cases">
					{group.items.map((item, index) => (
						<li>
							<details class="case" open={groupIndex === 0 && index === 0}>
								<summary>
									<span class="case-heading">
										<span class="case-title">{item.title}</span>
										<span class="case-context">{item.context}</span>
									</span>
									<span class="toggle" aria-hidden="true">
										<Icon name="chevron-down" size={18} />
									</span>
								</summary>
								<div class="case-body">
									<p class="problem">{item.problem}</p>
									<dl class="facts">
										<div>
											<dt>{ui.roleLabel}</dt>
											<dd>{item.role}</dd>
										</div>
										<div>
											<dt>{ui.outcomesLabel}</dt>
											<dd>
												<ul class="outcomes">
													{item.outcomes.map((outcome) => (
														<li>{outcome}</li>
													))}
												</ul>
											</dd>
										</div>
										<div>
											<dt>{ui.stackLabel}</dt>
											<dd>
												<ul class="stack-line">
													{item.stack.map((tech) => (
														<li>{tech}</li>
													))}
												</ul>
											</dd>
										</div>
									</dl>
									{(item.status || item.url) && (
										<p class="case-foot">
											{item.status && <span class="status">{item.status}</span>}
											{item.url && (
												<a href={item.url} target="_blank" rel="noopener noreferrer">
													{ui.visitLabel}
													<Icon name="arrow-up-right" size={14} />
												</a>
											)}
										</p>
									)}
								</div>
							</details>
						</li>
					))}
				</ul>
			</div>
		))
	}
</Section>

<style>
	.group + .group {
		margin-top: 3rem;
	}

	.group-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1.5rem;
		margin-bottom: 0.5rem;
	}

	.group-head h3 {
		font-size: 1.05rem;
		letter-spacing: -0.01em;
	}

	.group-head p {
		color: var(--ink-3);
		font-size: 0.875rem;
	}

	.cases li + li .case {
		border-top: 0;
	}

	.case {
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.2rem 0;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.case-heading {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.case-title {
		font-size: 1.15rem;
		font-weight: 650;
		letter-spacing: -0.015em;
		line-height: 1.3;
		transition: color 0.15s ease;
	}

	.case-context {
		color: var(--ink-3);
		font-size: 0.925rem;
		line-height: 1.45;
	}

	summary:hover .case-title {
		color: var(--accent);
	}

	.toggle {
		display: inline-grid;
		flex: none;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--line);
		border-radius: 50%;
		color: var(--ink-2);
		transition:
			transform 0.3s var(--ease-out),
			border-color 0.15s ease;
	}

	summary:hover .toggle {
		border-color: var(--ink-3);
	}

	.case[open] .toggle {
		transform: rotate(180deg);
	}

	.case-body {
		max-width: 46rem;
		padding-bottom: 1.75rem;
	}

	.case[open] .case-body {
		animation: case-in 0.4s var(--ease-out);
	}

	@keyframes case-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
	}

	.problem {
		color: var(--ink-2);
	}

	.facts {
		display: grid;
		gap: 1rem;
		margin: 1.25rem 0 0;
	}

	.facts > div {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		gap: 1rem;
	}

	dt {
		color: var(--ink-3);
		font-size: 0.85rem;
		font-weight: 600;
		padding-top: 0.15rem;
	}

	dd {
		margin: 0;
		font-size: 1rem;
		line-height: 1.55;
	}

	.outcomes li {
		position: relative;
		padding-left: 1.1rem;
	}

	.outcomes li + li {
		margin-top: 0.45rem;
	}

	.outcomes li::before {
		content: '';
		position: absolute;
		left: 0.1rem;
		top: 0.72em;
		width: 0.4rem;
		height: 1px;
		background: var(--ink-3);
	}

	.case-foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
		margin-top: 1.25rem;
		font-size: 0.9rem;
	}

	.status {
		color: var(--ink-3);
	}

	.case-foot a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-weight: 600;
		color: var(--accent);
		text-decoration: none;
	}

	.case-foot a:hover {
		text-decoration: underline;
	}

	@media (max-width: 560px) {
		.facts > div {
			grid-template-columns: 1fr;
			gap: 0.25rem;
		}
	}
</style>
