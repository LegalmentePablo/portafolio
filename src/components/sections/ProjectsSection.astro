---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import type { ProjectItem } from '../../data/portfolio';

interface Props {
	title: string;
	intro: string;
	items: ProjectItem[];
	sourceLabel: string;
}

const { title, intro, items, sourceLabel } = Astro.props;
---

<Section id="proyectos" title={title} intro={intro}>
	<ul class="projects">
		{
			items.map((item) => (
				<li>
					<a class="project" href={item.href} target="_blank" rel="noopener noreferrer">
						<span class="project-head">
							<h3>{item.title}</h3>
							<span class="source">
								{sourceLabel}
								<Icon name="arrow-up-right" size={14} />
							</span>
						</span>
						<p>{item.description}</p>
						<ul class="stack-line">
							{item.stack.map((tech) => (
								<li>{tech}</li>
							))}
						</ul>
					</a>
				</li>
			))
		}
	</ul>
</Section>

<style>
	.projects {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0 3rem;
	}

	.projects > li {
		border-bottom: 1px solid var(--line);
	}

	.project {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		height: 100%;
		padding: 1.4rem 0;
		text-decoration: none;
	}

	.project-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}

	h3 {
		font-size: 1.075rem;
		letter-spacing: -0.015em;
		line-height: 1.3;
		transition: color 0.15s ease;
	}

	.source {
		display: inline-flex;
		flex: none;
		align-items: center;
		gap: 0.25rem;
		color: var(--ink-3);
		font-size: 0.85rem;
		font-weight: 600;
		transition: color 0.15s ease;
	}

	.source :global(svg) {
		transition: transform 0.25s var(--ease-out);
	}

	.project:hover h3,
	.project:hover .source {
		color: var(--accent);
	}

	.project:hover .source :global(svg) {
		transform: translate(2px, -2px);
	}

	p {
		color: var(--ink-2);
		font-size: 0.975rem;
		line-height: 1.55;
	}

	@media (max-width: 760px) {
		.projects {
			grid-template-columns: 1fr;
		}
	}
</style>
