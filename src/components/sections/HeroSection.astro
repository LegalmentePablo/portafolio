---
import Icon from '../Icon.astro';
import type { PortfolioData } from '../../data/portfolio';

interface Props {
	hero: PortfolioData['hero'];
}

const { hero } = Astro.props;
---

<section class="hero container" id="top" aria-labelledby="hero-title">
	<div class="intro">
		<h1 id="hero-title">{hero.name}</h1>
		<p class="role">{hero.role}</p>
		<p class="lead">{hero.lead}</p>

		<div class="cta">
			<a class="button button-primary" href={hero.primaryCta.href}>
				<Icon name="mail" size={17} />
				{hero.primaryCta.label}
			</a>
			{
				hero.links.map((link) => (
					<a class="button button-quiet" href={link.href} target="_blank" rel="noopener noreferrer">
						{link.label}
						<Icon name="arrow-up-right" size={15} />
					</a>
				))
			}
		</div>

		<p class="meta">
			<span>{hero.location}</span>
			<span class="availability">
				<span class="dot" aria-hidden="true"></span>
				{hero.availability}
			</span>
		</p>
	</div>

	<aside class="now" aria-labelledby="now-title">
		<h2 id="now-title" class="now-title">
			{hero.now.title}
			<span class="now-company">{hero.now.company}</span>
		</h2>
		<ul class="now-list">
			{
				hero.now.items.map((item) => (
					<li>
						<span class="now-figure tabular">{item.figure}</span>
						<span class="now-label">{item.label}</span>
					</li>
				))
			}
		</ul>
		<a class="now-link" href="#experiencia">
			{hero.now.linkLabel}
			<Icon name="arrow-right" size={15} />
		</a>
	</aside>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
		gap: clamp(2.5rem, 6vw, 5.5rem);
		align-items: end;
		padding-top: clamp(3.5rem, 9vw, 7.5rem);
		padding-bottom: clamp(3.5rem, 8vw, 6rem);
	}

	.role {
		max-width: 34rem;
		margin-top: 0.75rem;
		color: var(--ink-3);
		font-size: clamp(1.4rem, 2.8vw, 2rem);
		font-weight: 600;
		line-height: 1.2;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	h1 {
		font-size: clamp(2.6rem, 6.6vw, 4.75rem);
		font-weight: 800;
		line-height: 0.98;
		letter-spacing: -0.035em;
	}

	.lead {
		max-width: 36rem;
		margin-top: 1.5rem;
		color: var(--ink-2);
		font-size: clamp(1.1rem, 1.6vw, 1.25rem);
		line-height: 1.55;
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 2rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0 1.1rem;
		border: 1px solid var(--line-strong);
		border-radius: 8px;
		font-size: 0.975rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			background-color 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.button-primary {
		background: var(--ink);
		border-color: var(--ink);
		color: var(--bg);
	}

	.button-primary:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}

	.button-quiet {
		color: var(--ink);
	}

	.button-quiet:hover {
		border-color: var(--ink);
	}

	.button-quiet :global(svg) {
		color: var(--ink-3);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.5rem;
		margin-top: 1.75rem;
		color: var(--ink-3);
		font-size: 0.925rem;
	}

	.availability {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
	}

	.now {
		padding-top: 1.25rem;
		border-top: 2px solid var(--ink);
	}

	.now-title {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		font-size: 0.975rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.now-company {
		color: var(--accent);
		font-weight: 600;
	}

	.now-list {
		margin-top: 0.75rem;
	}

	.now-list li {
		display: grid;
		grid-template-columns: 3rem minmax(0, 1fr);
		gap: 1rem;
		align-items: baseline;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--line);
	}

	.now-figure {
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.03em;
	}

	.now-label {
		color: var(--ink-2);
		font-size: 0.95rem;
		line-height: 1.45;
	}

	.now-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: 1rem;
		font-size: 0.925rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--ink);
	}

	.now-link :global(svg) {
		transition: transform 0.25s var(--ease-out);
	}

	.now-link:hover :global(svg) {
		transform: translateX(3px);
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			align-items: start;
		}
	}

	@media (max-width: 480px) {
		.cta {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 0.5rem;
		}

		.button {
			justify-content: center;
		}

		.button-primary {
			grid-column: 1 / -1;
		}
	}
</style>
